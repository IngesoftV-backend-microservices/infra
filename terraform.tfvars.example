# Example Terraform Variables Configuration
# Copy this file to environments/{dev|prod}/terraform.tfvars and fill in your values

# Environment (dev or prod)
environment = "dev"

# Azure region where resources will be created
location = "Canada Central"

# Resource naming
resource_group_name = "rg-ecommerce-microservices"
cluster_name        = "aks-ecommerce"
dns_prefix          = "ecommerce-k8s"

# Kubernetes version to use
kubernetes_version = "1.32"

# Networking configuration
vnet_name          = "aks-vnet"
vnet_address_space = ["10.0.0.0/16"]
subnet_names       = ["aks-subnet", "appgw-subnet"]
subnet_prefixes    = ["10.0.1.0/24", "10.0.2.0/24"]

# Default node pool configuration
# Dev: Standard_B2s, 2 nodes
# Prod: Standard_D2s_v3, 3 nodes
default_node_pool = {
  name            = "system"
  node_count      = 2
  vm_size         = "Standard_B2s"
  os_disk_size_gb = 30
  type            = "VirtualMachineScaleSets"
  max_pods        = 30
}

# Additional node pools (optional)
# Example for production:
# additional_node_pools = {
#   apps = {
#     node_count      = 3
#     vm_size         = "Standard_D2s_v3"
#     os_disk_size_gb = 50
#     max_pods        = 50
#   }
# }
additional_node_pools = {}

# Enable RBAC for cluster security
rbac_enabled = true

# Resource tags
tags = {
  Environment = "dev"
  ManagedBy   = "Terraform"
  Project     = "Ecommerce-Microservices"
  Owner       = "DevOps-Team"
  CostCenter  = "Engineering"
  Branch      = "develop"
}
